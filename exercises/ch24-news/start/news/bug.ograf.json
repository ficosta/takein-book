{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "takein.news.bug",
  "version": "1.0.0",
  "name": "News · Bug",
  "description": "O selo AO VIVO e a hora de Brasília, no canto de cima à direita.",
  "author": {
    "name": "Felipe Iasi"
  },
  "main": "bug.mjs",
  "stepCount": 1,
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "thumbnails": [
    {
      "file": "thumbnails/bug.png",
      "resolution": {
        "width": 960,
        "height": 540
      }
    }
  ],
  "schema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "title": "Texto do selo",
        "gddType": "single-line",
        "default": "Ao vivo"
      },
      "showClock": {
        "type": "boolean",
        "title": "Mostrar a hora",
        "default": true
      }
    }
  }
}
